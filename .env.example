# ---------------------------------------------------------------------------
# Example environment file. Copy to `.env` and adjust for your local setup.
#   cp .env.example .env
# Every variable here maps 1:1 to a field on `Settings` in app/config.py.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
# Public base used when building the returned short_url (no trailing slash).
BASE_URL=http://localhost:8000

# --- PostgreSQL (async SQLAlchemy DSN; must use the asyncpg driver) ---
# Matches the credentials in infra/docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://urlshortener:urlshortener@localhost:5433/urlshortener

# --- Redis (used for both caching and rate-limit state) ---
REDIS_URL=redis://localhost:6379/0

# --- Caching ---
# TTL (seconds) for cached short_code -> long_url entries. Default 1 hour.
CACHE_TTL_SECONDS=3600

# --- Rate limiting: redirect route class (GET /{short_code}) ---
RATE_LIMIT_REDIRECT_CAPACITY=100
RATE_LIMIT_REDIRECT_REFILL_PER_MINUTE=100

# --- Rate limiting: create route class (POST /api/urls) ---
RATE_LIMIT_CREATE_CAPACITY=10
RATE_LIMIT_CREATE_REFILL_PER_MINUTE=10

# --- Short code generation ---
# Length of auto-generated Base62 short codes.
SHORT_CODE_LENGTH=7
# Salt mixed into the client-IP hash so raw IPs are never recoverable.
IP_HASH_SALT=change-me-to-a-random-secret
